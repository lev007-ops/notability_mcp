# ---- paths (used by docker-compose.yml) ----
# Host folder with the Notability backups (it is the "Notability" folder Notability creates)
NOTABILITY_DIR=./notes
# uid/gid of the owner of that folder: `id -u` / `id -g`
PUID=1000
PGID=1000
HOST_PORT=8080
# timezone for dates shown to Claude
TZ=Europe/Moscow

# ---- public address (Caddy) ----
PUBLIC_URL=https://notes.example.com

# ---- auth ----
# Generate each with: docker compose run --rm notability-mcp hash-password
# Password you type on the login page when connecting Claude (claude.ai / Claude Code)
LOGIN_PASSWORD_HASH=
# WebDAV credentials you enter in Notability -> Settings -> Auto-backup -> WebDAV
DAV_USER=notability
DAV_PASSWORD_HASH=
# Hosts allowed as OAuth redirect targets (blocks phishing clients registering their own callback)
ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=5184000

# ---- transcription ----
# whisper (local, faster-whisper on CPU) | assemblyai | none
TRANSCRIBER=assemblyai
# language code or "auto"
TRANSCRIBE_LANGUAGE=ru
# periodically find new recordings and transcribe them in the background
AUTO_TRANSCRIBE=true
SCAN_INTERVAL=300

# whisper (fallback, local): large-v3-turbo (best, ~2 GB RAM) | medium | small (weak VPS)
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8
# 0 = all cores available to the container
WHISPER_THREADS=0
CPU_LIMIT=2
MEM_LIMIT=4g

# assemblyai: https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=
# optional: https://api.eu.assemblyai.com to keep audio in the EU
#ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
# optional, empty = account default model (must support Russian)
#ASSEMBLYAI_SPEECH_MODELS=
